        <mxCell id="director" value="Директор рассматривает документ&#xa;и формирует резолюцию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="145" width="240" height="100" as="geometry"/></mxCell>
