        <mxCell id="note" value="Схема построена по бизнес-требованию. Оранжевым отмечены места, требующие уточнения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="1000" height="45" as="geometry"/></mxCell>
