        <mxCell id="reg" value="СЮСОИД: создать карточку&#xa;Заполнить реквизиты, приложить PDF&#xa;или создать из e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="270" y="145" width="250" height="100" as="geometry"/></mxCell>
