        <mxCell id="legend" value="Зелёный — начало/завершение • Синий — действие • Фиолетовый — задача • Жёлтый — условие • Оранжевый — граница описания" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="75" width="1300" height="42" as="geometry"/></mxCell>

